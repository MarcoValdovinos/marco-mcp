# ─── 🪪 Identidad del titular ────────────────────────────────────
MARCO_OWNER="Marco Antonio Rojas Valdovinos"
MARCO_CONTACT="marco.a.rojas.v@hotmail.com"

# ─── 📁 Ruta del substrato (default: ./data) ─────────────────────
MARCO_CORE_PATH="./data"

# ─── 🐛 Debug (0 = off, 1 = on) ──────────────────────────────────
MARCO_DEBUG="0"

# ─── 🔐 Firma Ed25519 (opcional, para snapshots firmados) ────────
#
# Genera el par de llaves UNA SOLA VEZ:
#
#   node -e "const c=require('crypto');\
#   const{privateKey,publicKey}=c.generateKeyPairSync('ed25519');\
#   console.log('PRIVATE:');\
#   console.log(privateKey.export({type:'pkcs8',format:'pem'}).toString());\
#   console.log('PUBLIC:');\
#   console.log(publicKey.export({type:'spki',format:'pem'}).toString());"
#
# Guarda la privada en ~/.marco-keys/ed25519-private.pem (permisos 600)
# Guarda la pública en ~/.marco-keys/ed25519-public.pem (permisos 644)
#
# NUNCA commitees la clave privada. NUNCA la pegues en el repo.
#
ED25519_PRIVATE_KEY=""

# ─── ⛓️ Anclaje Ethereum (opcional) ──────────────────────────────
#
# Solo necesario si vas a anclar snapshots a Ethereum mainnet.
# Para pruebas, usa una red de test (Sepolia, Holesky).
#
# ETHEREUM_RPC_URL="https://sepolia.infura.io/v3/TU_PROJECT_ID"
# ETHEREUM_PRIVATE_KEY=""
ETHEREUM_RPC_URL=""
ETHEREUM_PRIVATE_KEY=""

# ─── 📢 Notificaciones (opcional) ────────────────────────────────
#
# Token de bot de Telegram para alertas de snapshots fallidos.
# Si no se configura, las alertas se omiten silenciosamente.
#
# TELEGRAM_BOT_TOKEN=""
# TELEGRAM_CHAT_ID=""
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# ═══════════════════════════════════════════════════════════════
#  Recuerda:
#  ✅ Este archivo SÍ va al repo (es template, sin secretos)
#  ❌ El .env.local NO va al repo (contiene secretos)
#  ── Marco Antonio Rojas Valdovinos ──
